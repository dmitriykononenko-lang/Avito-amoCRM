# Скопируйте в .env и заполните. .env НИКОГДА не коммитим.
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://avito.koagency.me
LOG_LEVEL=info

DATABASE_URL=postgres://avito:avito@localhost:5432/avito_amocrm
# для docker compose
POSTGRES_PASSWORD=

# 32 байта в base64: openssl rand -base64 32
MASTER_KEY=

# amoCRM OAuth (кабинет разработчика → Ключи)
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://avito.koagency.me/oauth/amocrm/callback

# amoCRM Chat API (выдаёт техподдержка после регистрации канала)
AMOJO_BASE_URL=https://amojo.amocrm.ru
AMOJO_CHANNEL_ID=
AMOJO_CHANNEL_SECRET=
AMOJO_CHANNEL_CODE=

# Avito (приложение ko:agency)
AVITO_BASE_URL=https://api.avito.ru
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_REDIRECT_URI=https://avito.koagency.me/oauth/avito/callback

# Алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Хранение файлов (записи звонков, вложения)
STORAGE_DIR=./storage
FILE_TTL_DAYS=90
INBOX_TTL_DAYS=14
